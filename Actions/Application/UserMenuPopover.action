{
	"_Type": "Action.Type.PopoverMenu",
	"PopoverItems": [
		{
			"Enabled": true,
			"Icon": "sap-icon://synchronize",
			"OnPress": "/Skycm_v3/Actions/Service/SyncStartedMessage.action",
			"Title": "Sincronizar datos",
			"Visible": "$(PLT,true,true,false)"
		},
		{
			"Enabled": true,
			"Icon": "sap-icon://headset",
			"OnPress": "/Skycm_v3/Actions/Application/NavToSupport.action",
			"Title": "Soporte",
			"Visible": true
		},
		{
			"Enabled": true,
			"Icon": "sap-icon://refresh",
			"OnPress": "/Skycm_v3/Actions/Application/AppUpdateProgressBanner.action",
			"Title": "Actualizar app",
			"Visible": "$(PLT,true,true,false)"
		},
		{
			"Enabled": true,
			"Icon": "sap-icon://reset",
			"OnPress": "/Skycm_v3/Actions/Application/ResetMessage.action",
			"Title": "Logout",
			"Visible": true
		},
		{
			"Enabled": true,
			"Icon": "sap-icon://log",
			"OnPress": "/Skycm_v3/Actions/Application/Logout.action",
			"Title": "Logout",
			"Visible": "/Skycm_v3/Rules/Application/ClientIsMultiUserMode.js"
		},
		{
			"Enabled": true,
			"Icon": "sap-icon://hint",
			"OnPress": "/Skycm_v3/Actions/Application/NavToAbout.action",
			"Title": "About",
			"Visible": true
		},
		{
			"Title": "Inicializar",
			"Icon": "sap-icon://accept",
			"Style": "",
			"OnPress": "/Skycm_v3/Actions/Service/InitializeOffline.action",
			"Visible": true,
			"Enabled": true
		},
		{
			"Title": "Restaurar",
			"Icon": "sap-icon://reset",
			"Style": "",
			"OnPress": "/Skycm_v3/Actions/Service/clear_store.action",
			"Visible": true,
			"Enabled": true
		}
	]
}